# Server-only settings. Never commit web/.env or put these in the Android .env.
ADMIN_PASSWORD=replace-with-a-unique-long-password
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Choose a Responses API text model available in your OpenAI project.
OPENAI_MODEL=
OPENAI_API_KEY=
# Production: use a persistent disk, one server process, and backup this database.
DATA_FILE=./data/marketing.sqlite

# Optional real media generation (server only). Requires provider billing/access.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview
OPENAI_IMAGE_MODEL=gpt-image-1
# Defaults to media/ next to DATA_FILE. Keep it on the same persistent disk.
# MEDIA_DIR=/var/data/media

# Optional team roles: distinct passwords, each at least 16 characters.
STAFF_PASSWORD=
CREATOR_PASSWORD=

# Optional read-only Meta connection. Never put the token in browser code.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_API_VERSION=v25.0

# Separate, random, server-only app sync tokens (32+ characters each).
# Blank tokens keep machine access disabled. Enable each connection in the UI.
RVH_CLINIC_SYNC_TOKEN=
RVH_MART_SYNC_TOKEN=
RVH_CHAT_SYNC_TOKEN=

# Optional read-only Google Search Console import; server secrets only.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
